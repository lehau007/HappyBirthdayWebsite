# Copy this file to .env and fill in the values before running the application.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/happybirthday

# NVIDIA NIM API key — get yours at https://integrate.api.nvidia.com
# Set this as OPENAI_API_KEY (the field name is kept for config compatibility)
OPENAI_API_KEY=nvapi-replace-me

# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS: the origin your frontend is served from
FRONTEND_ORIGIN=http://localhost:5173
